# 校园网配置（安装后自动生成在 /data/adb/campusnet/config.conf）
# 修改后无需重启，下一轮检测自动生效

# 认证网关（湖北工业大学默认 172.16.54.18，其他学校按实际改）
CFG_GATEWAY=172.16.54.18

# 学号 / 密码（必填；密码含 & # 空格 等特殊字符无需转义，原样填写即可）
CFG_USER=你的学号
CFG_PASSWORD=你的密码

# 校园网 WiFi 名称（多个用逗号分隔，子串匹配；留空=不限网络）
CFG_SSID=iHBUT

# 服务尝试顺序：LT=联通 default=校园网 YD=移动 DX=电信（空格分隔）
CFG_SERVICES=LT default YD DX

# 检测间隔（秒，建议 60~180）
CFG_INTERVAL=60
